# ---- Runtime ----
APP_ENV=development                # development | test | production
DEMO_MODE=false                    # safe demo conveniences only; never changes business behaviour
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production for structured logs

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealflow360
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- Auth ----
SECRET_KEY=change-me-to-a-long-random-string          # e.g. `openssl rand -hex 48`
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=60
PORTAL_TOKEN_HOURS=168
COOKIE_SECURE=false                # true behind HTTPS
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
MAX_FAILED_LOGINS_BEFORE_LOCK=8
ACCOUNT_LOCK_MINUTES=15
MIN_PASSWORD_LENGTH=10
PASSWORD_HASH_ROUNDS=12

# ---- Web ----
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Email (NotificationService -> EmailProvider) ----
EMAIL_PROVIDER=console             # console | smtp | disabled
EMAIL_FROM=DealFlow360 <no-reply@dealflow360.local>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- Payments ----
PAYMENT_PROVIDER=manual            # manual (gateway providers plug in here)

# ---- Business defaults ----
DEFAULT_CURRENCY=USD
INVOICE_DUE_DAYS=14
QUOTE_VALID_DAYS=30
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
MAX_EXPORT_ROWS=5000

# ---- Deal-health defaults (editable at runtime under Admin > Settings) ----
STALL_THRESHOLD_DAYS=7
DISCOUNT_ANOMALY_MULTIPLIER=1.5
DELIVERY_SLIPPAGE_WARNING_DAYS=0
DELIVERY_SLIPPAGE_CRITICAL_DAYS=5
APPROVAL_AGING_DAYS=3
NEGOTIATION_AGING_DAYS=5
PAYMENT_OVERDUE_GRACE_DAYS=0
